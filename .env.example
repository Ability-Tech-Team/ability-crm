# Ability CRM environment — sanitized example (tracked).
# For local use: cp .env.example .env.local (ignored by Git).
# For the container (README.md, Container): cp .env.example .env.production,
# and write the values without quotes.
# Never use Amer CRM's API URL, cookies, or secrets in this app.

# The Ability CRM API addresses this app accepts (docs/ABILITY-CRM-BACKEND-CHANGES.md),
# comma-separated, each with the API's /crm prefix. The value below is the
# development server (named api-prd, but it is the development server). Each
# client's address comes with its sign-in (`platforms[crm].apiUrl`); the
# deployed browser then calls it directly with the backend's HttpOnly
# `access_token` cookie. Under `npm run dev` the browser calls this app's own
# /api/dev-proxy/crm/<n> instead, which forwards to the n-th address here, so
# local runs need no CORS entry (src/lib/devApiProxy.ts; restart `npm run dev`
# after changing this list). An address not listed here is never used.
# https:, or http: for loopback and private-network dev hosts. Server-only,
# read at runtime.
API_ALLOWED_URLS=https://api-prd.ability-tech.com/crm

# Ability Portal, where users sign in. Signed-out visits, and sessions the API
# ends, go to its sign-in page and come back. Server-only, read at runtime.
PORTAL_URL=http://localhost:9992

# Media proxy (src/app/api/media/route.ts): extra https hosts it may fetch
# private files from, comma-separated, `*.` wildcards allowed. The API's host
# and S3 hosts are always allowed. Server-only.
MEDIA_ALLOWED_HOSTS=
