# Ability CRM environment — sanitized example (tracked).
# For local use: cp .env.example .env.local (ignored by Git).
# Do not copy Amer CRM's API URL, cookie names, or secrets into this app.
#
# Clients sign in on Ability Portal. This app checks the shared session with
# the account service on every page (contract: ../docs/ACCOUNT-SERVICE-API.md).
# Server-only values, read when the server starts: never prefix them with
# NEXT_PUBLIC_. Without them, pages show an access-check error, never the
# product.
ACCOUNT_SERVICE_URL=http://localhost:3400
ACCOUNT_SERVICE_CLIENT_ID=ability-crm
# Issued by the backend team. Keep it in .env.local only, never committed.
ACCOUNT_SERVICE_CLIENT_SECRET=

# Ability Portal, where signed-out clients are sent to sign in.
PORTAL_URL=http://localhost:3300
